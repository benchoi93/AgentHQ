{
  "mcpServers": {
    "commander": {
      "command": "python3",
      "args": ["/absolute/path/to/AgentHQ/commander/mcp_server.py"],
      "env": {
        "AGENTHQ_URL": "http://localhost:8420",
        "AGENTHQ_TOKEN": "your-agenthq-token",
        "TELEGRAM_BOT_TOKEN": "123456:ABC-DEF...",
        "TELEGRAM_CHAT_ID": "123456789"
      }
    }
  }
}
